# Set up a vhost-net TX virtqueue backed by /macvtap0 and kick it.
# The descriptor points to a 10-byte virtio_net_hdr (the default macvtap vnet header size)
# followed by a UDP frame that is transmitted via macvtap0 to veth0_macvtap.
# requires: sandbox=none

r0 = eventfd2(0x0, 0x0)
r1 = openat$macvtap(AUTO, &AUTO, 0x2, AUTO)
r2 = openat$vnet(AUTO, &AUTO, AUTO, AUTO)
ioctl$VHOST_SET_OWNER(r2, AUTO, AUTO)
ioctl$VHOST_SET_MEM_TABLE(r2, AUTO, &AUTO={AUTO, AUTO, [{0x0, AUTO, &AUTO="00000000000000000000ffffffffffffaaaaaaaaaaaa08004500001c0001000040110000ac1414bbac1414aa138813890008000000000000000000000000", AUTO}]})
ioctl$VHOST_SET_VRING_NUM_pow2(r2, AUTO, &AUTO={0x1, 0x10})
ioctl$VHOST_SET_VRING_ADDR_ring(r2, AUTO, &AUTO={0x1, 0x0, &AUTO=[{0x0, 0x3e, 0x0, 0x0}], &AUTO={0x0, 0x0, [{0x0, 0x0}, {0x0, 0x0}, {0x0, 0x0}, {0x0, 0x0}, {0x0, 0x0}, {0x0, 0x0}, {0x0, 0x0}, {0x0, 0x0}, {0x0, 0x0}, {0x0, 0x0}, {0x0, 0x0}, {0x0, 0x0}, {0x0, 0x0}, {0x0, 0x0}, {0x0, 0x0}, {0x0, 0x0}], 0x0}, &AUTO={0x0, 0x1, [0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0], 0x0}, 0x0})
ioctl$VHOST_SET_VRING_KICK(r2, AUTO, &AUTO={0x1, r0})
ioctl$VHOST_NET_SET_BACKEND_tun(r2, AUTO, &AUTO={0x1, r1})
write$eventfd(r0, &AUTO=0x1, AUTO)
