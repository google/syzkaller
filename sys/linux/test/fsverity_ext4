# requires: -arch=arm -arch=s390x
# Mounts a clean ext4 filesystem with verity enabled, writes a multi-block
# file, closes the writable descriptor, enables SHA-256 fs-verity on a
# read-only descriptor, evicts cached pages, and reads/measures the file.
# fadvise64 is missing on arm and POSIX_FADV_DONTNEED differs on s390x.
# Image: mkfs.ext4 -F -L syzkaller -U clear -N 256 -b 4096 -O verity (8 MiB file).

r0 = syz_mount_image$ext4(&AUTO='ext4\x00', &AUTO='./mnt\x00', 0x0, &AUTO, 0x0, AUTO, &AUTO="$")
mknodat(r0, &AUTO='verity_file\x00', 0x8180, 0x0)
r1 = openat(r0, &AUTO='verity_file\x00', 0x2, 0x0)
pwrite64(r1, &AUTO="41414141", AUTO, 0x0)
pwrite64(r1, &AUTO="42424242", AUTO, 0x1000)
close(r1)
r2 = openat(r0, &AUTO='verity_file\x00', 0x0, 0x0)
ioctl$FS_IOC_ENABLE_VERITY(r2, AUTO, &AUTO={AUTO, 0x1, 0x1000, AUTO, 0x0, AUTO, AUTO, 0x0, ""/88})
fadvise64(r2, 0x0, 0x0, 0x4)
pread64(r2, &AUTO=""/8192, AUTO, 0x0)
ioctl$FS_IOC_MEASURE_VERITY(r2, AUTO, &AUTO={0x1, AUTO, ""/64})
