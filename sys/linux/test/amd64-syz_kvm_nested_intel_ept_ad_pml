#
# requires: arch=amd64 vendor=intel nested -threaded
#
r0 = openat$kvm(0, &AUTO='/dev/kvm\x00', 0x0, 0x0)
r1 = ioctl$KVM_CREATE_VM(r0, AUTO, 0x0)
r2 = syz_kvm_setup_syzos_vm$x86(r1, &(0x7f0000c00000/0x400000)=nil)

# Test the emulation of the EPT accessed/dirty bits and of page-modification logging for L2.
#
# L1 points the PML address of the VM at a scratch page (page type 50) and enables the A/D bits in
# its EPT pointer (bit 6). L2 executes "push rax; mov [0x41000], rax; hlt". The EPT entries of L1 do
# not have the dirty bit set, so L0 has to set it and to log the page when L2 writes to it:
#  - the push dirties the stack page, which is logged at the PML index 0;
#  - the write to 0x41000 makes the CPU set the dirty bit in the L2 page tables, i.e. dirty one
#    more page, but the PML index has wrapped around, so the buffer is full.
#
r3 = syz_kvm_add_vcpu$x86(r2, &AUTO={0x0, &AUTO=[@enable_nested={AUTO, AUTO, 0x0}, @nested_create_vm={AUTO, AUTO, 0x0}, @nested_load_code={AUTO, AUTO, {0x0, "5048a30010040000000000f4"}}, @nested_set_state_pages={AUTO, AUTO, {0x0, 0x32, @arbitrary=0x58000}}, @nested_intel_vmwrite_mask={AUTO, AUTO, {0x0, @control64=0x201a, 0x40, 0x0, 0x0}}, @nested_vmlaunch={AUTO, AUTO, 0x0}], AUTO})
r4 = ioctl$KVM_GET_VCPU_MMAP_SIZE(r0, AUTO)
r5 = mmap$KVM_VCPU(&(0x7f0000009000/0x1000)=nil, r4, 0x3, 0x1, r3, 0x0)

# L0 reflects the full PML buffer to L1 as a VM exit with the reason 62 (PML_FULL), which SYZOS
# reports as 0xe211003e.
#
ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$x86(r3, r5, 0xe211003e)
