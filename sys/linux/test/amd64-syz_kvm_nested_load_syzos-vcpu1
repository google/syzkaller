#
# requires: arch=amd64 nested -threaded
#
r0 = openat$kvm(0, &AUTO='/dev/kvm\x00', 0x0, 0x0)
r1 = ioctl$KVM_CREATE_VM(r0, AUTO, 0x0)
r2 = syz_kvm_setup_syzos_vm$x86(r1, &(0x7f0000c00000/0x400000)=nil)

# Test nested_load_syzos on a vCPU other than vCPU 0.
#
# vCPU 0 gets a program with two commands. vCPU 1 loads a one-command SYZOS program into an L2 VM
# and runs it.
#
r3 = syz_kvm_add_vcpu$x86(r2, &AUTO={0x0, &AUTO=[@uexit={AUTO, AUTO, 0xaaaa}, @uexit={AUTO, AUTO, 0xbbbb}], AUTO})
r4 = ioctl$KVM_GET_VCPU_MMAP_SIZE(r0, AUTO)
r5 = mmap$KVM_VCPU(&(0x7f0000009000/0x1000)=nil, r4, 0x3, 0x1, r3, 0x0)
r6 = syz_kvm_add_vcpu$x86(r2, &AUTO={0x0, &AUTO=[@enable_nested={AUTO, AUTO, 0x0}, @nested_create_vm={AUTO, AUTO, 0x0}, @nested_load_syzos={AUTO, AUTO, {0x0, 0x0, [@uexit={AUTO, AUTO, 0xfacefeed}]}}, @nested_vmlaunch={AUTO, AUTO, 0x0}, @uexit={AUTO, AUTO, 0xcccc}], AUTO})
r7 = mmap$KVM_VCPU(&(0x7f000000a000/0x1000)=nil, r4, 0x3, 0x1, r6, 0x0)

# L2 must execute the nested program, not the L1 program of vCPU 1 (the user code pages of L2 used
# to be identity-mapped for all vCPUs but vCPU 0). The top byte of the exit code is the nesting
# level.
#
ioctl$KVM_RUN(r6, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$x86(r6, r7, 0x1000000facefeed)

# L1 continues with the next command.
#
ioctl$KVM_RUN(r6, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$x86(r6, r7, 0xcccc)
ioctl$KVM_RUN(r6, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$x86(r6, r7, 0xffffffffffffffff)

# Loading the nested program must not change the program size of vCPU 0, which has not started
# yet (nested_load_syzos used to write the nested program size to the L1 globals of every vCPU),
# so vCPU 0 executes both of its commands.
#
ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$x86(r3, r5, 0xaaaa)
ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$x86(r3, r5, 0xbbbb)
ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$x86(r3, r5, 0xffffffffffffffff)
