# Mounts a clean ext4 filesystem with encrypt enabled, registers a v1 logon key
# in the process keyring, applies a v1 encryption policy, and creates and
# writes an encrypted file.
# Image: mkfs.ext4 -F -L syzkaller -U clear -N 256 -b 4096 -O encrypt,stable_inodes (8 MiB file).

r0 = syz_mount_image$ext4(&AUTO='ext4\x00', &AUTO='./mnt\x00', 0x0, &AUTO, 0x0, AUTO, &AUTO="$")
add_key$fscrypt_v1(&AUTO='logon\x00', &AUTO={'ext4:', @desc1='0000111122223333', AUTO}, &AUTO={AUTO, "0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f40", 0x40}, AUTO, AUTO)
mkdirat(r0, &AUTO='enc_v1\x00', 0x1c0)
r1 = openat(r0, &AUTO='enc_v1\x00', 0x0, 0x0)
ioctl$FS_IOC_SET_ENCRYPTION_POLICY(r1, AUTO, &AUTO=@v1={AUTO, @aes256, 0x2, @desc1="0000111122223333"})
mknodat(r1, &AUTO='secret\x00', 0x8180, 0x0)
r2 = openat(r1, &AUTO='secret\x00', 0x2, 0x0)
pwrite64(r2, &AUTO='fscrypt_v1_payload', AUTO, 0x0)
