# from the saved VMCB, and has to reload the pages referenced by it on the next KVM_RUN.
# The buffer is a resource, so that the saved state is restored as is.
#
r6 = syz_create_resource$kvm_nested_state(&AUTO=@svm={0x0, AUTO, AUTO, {0x0, 0x0}, {""/4096}})
ioctl$KVM_GET_NESTED_STATE_res(r3, AUTO, r6)
ioctl$KVM_SET_NESTED_STATE_res(r3, AUTO, r6)

# L2 continues after the OUT and executes HLT.
#
ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$x86(r3, r5, 0xe2e20001)
