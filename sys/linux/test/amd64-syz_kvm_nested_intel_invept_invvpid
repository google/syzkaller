#
# requires: arch=amd64 vendor=intel nested -threaded
#
r0 = openat$kvm(0, &AUTO='/dev/kvm\x00', 0x0, 0x0)
r1 = ioctl$KVM_CREATE_VM(r0, AUTO, 0x0)
r2 = syz_kvm_setup_syzos_vm$x86(r1, &(0x7f0000c00000/0x400000)=nil)

# Test INVEPT and INVVPID executed by L1.
#
# L1 runs an L2 VM once, so that L0 has a shadow EPT root for it, and then executes:
#  - INVEPT type 1 (single-context) with the EPT pointer of the VM (0x40401e);
#  - INVEPT type 2 (all-contexts);
#  - INVEPT with the invalid type 0, which fails;
#  - INVVPID type 1 (single-context) for VPID 1;
#  - INVVPID type 2 (all-contexts);
#  - INVVPID type 0 (individual-address) for VPID 1;
#  - INVVPID type 1 with the invalid VPID 0, which fails.
# The failures must not prevent L1 from executing the rest of the program.
#
r3 = syz_kvm_add_vcpu$x86(r2, &AUTO={0x0, &AUTO=[@enable_nested={AUTO, AUTO, 0x0}, @nested_create_vm={AUTO, AUTO, 0x0}, @nested_load_code={AUTO, AUTO, {0x0, "f4"}}, @nested_vmlaunch={AUTO, AUTO, 0x0}, @nested_intel_invept={AUTO, AUTO, {0x1, 0x40401e}}, @nested_intel_invept={AUTO, AUTO, {0x2, 0x0}}, @nested_intel_invept={AUTO, AUTO, {0x0, 0x0}}, @nested_intel_invvpid={AUTO, AUTO, {0x1, 0x1, 0x0}}, @nested_intel_invvpid={AUTO, AUTO, {0x2, 0x0, 0x0}}, @nested_intel_invvpid={AUTO, AUTO, {0x0, 0x1, 0x50000}}, @nested_intel_invvpid={AUTO, AUTO, {0x1, 0x0, 0x0}}, @nested_vmresume={AUTO, AUTO, 0x0}, @uexit={AUTO, AUTO, 0xface}], AUTO})
r4 = ioctl$KVM_GET_VCPU_MMAP_SIZE(r0, AUTO)
r5 = mmap$KVM_VCPU(&(0x7f0000009000/0x1000)=nil, r4, 0x3, 0x1, r3, 0x0)

# L2 executes HLT.
#
ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$x86(r3, r5, 0xe2e20001)

# After the invalidations L1 resumes L2, which executes HLT again (SYZOS does not advance the L2
# RIP past HLT), so L0 has to rebuild the shadow EPT.
#
ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$x86(r3, r5, 0xe2e20001)
ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$x86(r3, r5, 0xface)
ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$x86(r3, r5, 0xffffffffffffffff)
