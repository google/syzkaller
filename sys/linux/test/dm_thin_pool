ioctl$DM_TABLE_LOAD(r0, AUTO, &AUTO={AUTO, AUTO, AUTO, AUTO, AUTO, AUTO, AUTO, 0x0, AUTO, AUTO, @by_name={0x0, {'syz', 0x0, '2\x00'}}, [@thin_pool={AUTO, 0x2000, AUTO, AUTO, 'thin-pool\x00', {@ram={'/dev/ram', 0x0}, AUTO, @ram={'/dev/ram', 0x1}, AUTO, '128', AUTO, 0x0, ''}, AUTO}]})
ioctl$DM_DEV_SUSPEND(r0, AUTO, &AUTO={AUTO, AUTO, AUTO, AUTO, AUTO, AUTO, AUTO, 0x0, AUTO, AUTO, @by_name={0x0, {'syz', 0x0, '2\x00'}}, ""})
ioctl$DM_TARGET_MSG(r0, AUTO, &AUTO={AUTO, AUTO, AUTO, AUTO, AUTO, AUTO, AUTO, 0x0, AUTO, AUTO, @by_name={0x0, {'syz', 0x0, '2\x00'}}, {0x0, @thin_create={'create_thin ', 0x0}, AUTO}})
ioctl$DM_TABLE_STATUS(r0, AUTO, &AUTO={AUTO, AUTO, AUTO, AUTO, AUTO, AUTO, AUTO, 0x0, AUTO, AUTO, @by_name={0x0, {'syz', 0x0, '2\x00'}}, ""/256})
ioctl$DM_TARGET_MSG(r0, AUTO, &AUTO={AUTO, AUTO, AUTO, AUTO, AUTO, AUTO, AUTO, 0x0, AUTO, AUTO, @by_name={0x0, {'syz', 0x0, '2\x00'}}, {0x0, @thin_pool='delete 0', AUTO}})
ioctl$DM_DEV_REMOVE(r0, AUTO, &AUTO={AUTO, AUTO, AUTO, AUTO, AUTO, AUTO, AUTO, 0x20000, AUTO, AUTO, @by_name={0x0, {'syz', 0x0, '2\x00'}}, ""})
