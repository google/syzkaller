# Mounts a clean ext4 filesystem with encrypt enabled using
# test_dummy_encryption=v2 and creates and writes a file in a new directory,
# which inherits the dummy encryption policy.
# Image: mkfs.ext4 -F -L syzkaller -U clear -N 256 -b 4096 -O encrypt,stable_inodes (8 MiB file).

r0 = syz_mount_image$ext4(&AUTO='ext4\x00', &AUTO='./mnt\x00', 0x0, &AUTO={[{@test_dummy_encryption_v2='test_dummy_encryption=v2', AUTO}], [], AUTO}, 0x0, AUTO, &AUTO="$")
mkdirat(r0, &AUTO='dummy_dir\x00', 0x1c0)
r1 = openat(r0, &AUTO='dummy_dir\x00', 0x0, 0x0)
mknodat(r1, &AUTO='dummy_file\x00', 0x8180, 0x0)
r2 = openat(r1, &AUTO='dummy_file\x00', 0x2, 0x0)
pwrite64(r2, &AUTO='dummy_encryption_payload', AUTO, 0x0)
