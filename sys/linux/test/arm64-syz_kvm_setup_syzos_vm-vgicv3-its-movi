# Initialize vCPU 1 first so its VBAR_EL1 and GIC CPU interface are ready, then run vCPU 0 to set
# up the ITS and issue GITS_CMD_MOVI (0x1) moving event 0 from collection 0 to collection 1.
#
ioctl$KVM_RUN(r4, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$arm64(r4, r8, 0xffffffffffffffff)
ioctl$KVM_RUN(r3, AUTO, 0x0)
