r3 = syz_kvm_add_vcpu$arm64(r2, &AUTO={0x0, &AUTO=[@irq_setup={AUTO, AUTO, {0x2, 0x20}}, @its_setup={AUTO, AUTO, {0x2, 0x1, 0x1}}, @its_send_cmd={AUTO, AUTO, {0x1, 0x0, 0x1, 0x0, 0x0, 0x0, 0x0}}], AUTO}, 0x0, 0x0)
r4 = syz_kvm_add_vcpu$arm64(r2, &AUTO={0x0, &AUTO=[@irq_setup={AUTO, AUTO, {0x2, 0x20}}], AUTO}, 0x0, 0x0)
syz_kvm_vgic_v3_setup(r1, 0x2, 0x100)

