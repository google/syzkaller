#
ioctl$KVM_SIGNAL_MSI(r1, AUTO, &AUTO={0x8090040, 0x0, 0x0, 0x1, 0x0, ""})
ioctl$KVM_RUN(r4, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$arm64(r4, r8, 0xfffffffffffffffe)
