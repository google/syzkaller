#
ioctl$KVM_CREATE_DEVICE(r1, AUTO, &AUTO={0x8, <r5=>0xffffffffffffffff, 0x0})
ioctl$KVM_SET_DEVICE_ATTR(r5, AUTO, &AUTO=@attr_arm64={0x0, 0x0, 0x4, &AUTO=0x08080000})
ioctl$KVM_SET_DEVICE_ATTR(r5, AUTO, &AUTO=@attr_arm64={0x0, 0x4, 0x0, 0x0})

