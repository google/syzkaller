#
# requires: arch=arm64 -threaded
#
r0 = openat$kvm(0, &AUTO='/dev/kvm\x00', 0x0, 0x0)
r1 = ioctl$KVM_CREATE_VM(r0, AUTO, 0x0)
r2 = syz_kvm_setup_syzos_vm$arm64(r1, &(0x7f0000c00000/0x400000)=nil)

# Four vCPUs execute code triggering synchronous exceptions:
# - vCPU 0: udf #0 -> vector 4 (Current EL with SPx, Sync).
# - vCPU 1: mov x0, #0; mov sp, x0; brk #0 -> vector 4 with corrupted SP_EL1.
# - vCPU 2: msr spsel, #0; udf #0 -> vector 0 (Current EL with SP0, Sync).
# - vCPU 3: @svc (EC = 0x15), which is resumed with eret, followed by @uexit(0xbbbb).
#
r3 = syz_kvm_add_vcpu$arm64(r2, &AUTO={0x0, &AUTO=[@code={AUTO, AUTO, {"00000000", 0xd65f03c0}}, @uexit={AUTO, AUTO, 0xaaaa}], AUTO}, 0x0, 0x0)
r4 = ioctl$KVM_GET_VCPU_MMAP_SIZE(r0, AUTO)
r5 = mmap$KVM_VCPU(&(0x7f0000009000/0x1000)=nil, r4, 0x3, 0x1, r3, 0x0)
r6 = syz_kvm_add_vcpu$arm64(r2, &AUTO={0x0, &AUTO=[@code={AUTO, AUTO, {"000080d21f000091000020d4", 0xd65f03c0}}, @uexit={AUTO, AUTO, 0xaaaa}], AUTO}, 0x0, 0x0)
r7 = mmap$KVM_VCPU(&(0x7f000000a000/0x1000)=nil, r4, 0x3, 0x1, r6, 0x0)
r8 = syz_kvm_add_vcpu$arm64(r2, &AUTO={0x0, &AUTO=[@code={AUTO, AUTO, {"bf4000d500000000", 0xd65f03c0}}, @uexit={AUTO, AUTO, 0xaaaa}], AUTO}, 0x0, 0x0)
r9 = mmap$KVM_VCPU(&(0x7f000000b000/0x1000)=nil, r4, 0x3, 0x1, r8, 0x0)
r10 = syz_kvm_add_vcpu$arm64(r2, &AUTO={0x0, &AUTO=[@svc={AUTO, AUTO, {0x0, [0x0, 0x0, 0x0, 0x0, 0x0]}}, @uexit={AUTO, AUTO, 0xbbbb}], AUTO}, 0x0, 0x0)
r11 = mmap$KVM_VCPU(&(0x7f000000c000/0x1000)=nil, r4, 0x3, 0x1, r10, 0x0)

# Unrecoverable exceptions are reported as UEXIT_EXCEPTION(vector) = 0xe2ec0000 | vector.
#
ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$arm64(r3, r5, 0xe2ec0004)
ioctl$KVM_RUN(r6, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$arm64(r6, r7, 0xe2ec0004)
ioctl$KVM_RUN(r8, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$arm64(r8, r9, 0xe2ec0000)

# A vCPU that hit an unrecoverable exception never returns: resuming it reports the same
# exception again instead of reaching uexit(0xaaaa).
#
ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$arm64(r3, r5, 0xe2ec0004)

# SVC64 is still resumed with eret, so vCPU 3 continues with @uexit(0xbbbb).
#
ioctl$KVM_RUN(r10, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$arm64(r10, r11, 0xbbbb)
ioctl$KVM_RUN(r10, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$arm64(r10, r11, 0xffffffffffffffff)
