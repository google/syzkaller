# Mounts a clean 8 MiB ext4 filesystem with resize_inode and 512-block groups,
# online-resizes it from 4 to 12 block groups (24 MiB) using the loop device's
# sparse slack space, and allocates blocks spanning the newly added groups.
# EXT4_IOC_RESIZE_FS is only enabled in snapshot mode.
# Image: mkfs.ext4 -F -L syzkaller -U clear -N 256 -b 4096 -g 512 (8 MiB file).

r0 = syz_mount_image$ext4(&AUTO='ext4\x00', &AUTO='./mnt\x00', 0x0, &AUTO, 0x0, AUTO, &AUTO="$")
ioctl$EXT4_IOC_RESIZE_FS(r0, AUTO, &AUTO=0x1800)
mknodat(r0, &AUTO='grown\x00', 0x8180, 0x0)
r1 = openat(r0, &AUTO='grown\x00', 0x2, 0x0)
fallocate(r1, 0x0, 0x0, 0xc00000)
pwrite64(r1, &AUTO='resized_extent_data', AUTO, 0xbff000)
