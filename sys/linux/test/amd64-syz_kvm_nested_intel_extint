#
# requires: arch=amd64 vendor=intel nested -threaded
#
r0 = openat$kvm(0, &AUTO='/dev/kvm\x00', 0x0, 0x0)
r1 = ioctl$KVM_CREATE_VM(r0, AUTO, 0x0)
ioctl$KVM_CREATE_IRQCHIP(r1, AUTO)
r2 = syz_kvm_setup_syzos_vm$x86(r1, &(0x7f0000c00000/0x400000)=nil)

# Test an external interrupt that arrives while the vCPU is in L2.
#
# The VM has an in-kernel irqchip. L1 enables external-interrupt exiting (pin-based control bit 0)
# and "acknowledge interrupt on exit" (VM-exit control bit 15).
# L2 executes "mov dx, 0x1234; out dx, al; hlt".
#
r3 = syz_kvm_add_vcpu$x86(r2, &AUTO={0x0, &AUTO=[@enable_nested={AUTO, AUTO, 0x0}, @nested_create_vm={AUTO, AUTO, 0x0}, @nested_load_code={AUTO, AUTO, {0x0, "66ba3412eef4"}}, @nested_intel_vmwrite_mask={AUTO, AUTO, {0x0, @control32=0x4000, 0x1, 0x0, 0x0}}, @nested_intel_vmwrite_mask={AUTO, AUTO, {0x0, @control32=0x400c, 0x8000, 0x0, 0x0}}, @nested_vmlaunch={AUTO, AUTO, 0x0}], AUTO})
r4 = ioctl$KVM_GET_VCPU_MMAP_SIZE(r0, AUTO)
r5 = mmap$KVM_VCPU(&(0x7f0000009000/0x1000)=nil, r4, 0x3, 0x1, r3, 0x0)

# L1 does not intercept I/O, so the OUT in L2 exits to userspace with KVM_EXIT_IO (0x2) while the
# vCPU is still in guest mode.
#
ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_kvm_exit$x86(r5, 0x2)

# Raise IRQ 0 of the PIC. vmx_check_nested_events() must turn the interrupt into a nested VM exit
# with the exit reason 1 (EXTERNAL_INTERRUPT), which SYZOS reports as 0xe2110001.
#
ioctl$KVM_IRQ_LINE(r1, AUTO, &AUTO={0x0, 0x1})
ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$x86(r3, r5, 0xe2110001)
