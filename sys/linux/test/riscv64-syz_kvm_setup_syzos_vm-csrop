#
# requires: arch=riscv64 -threaded
#

# Exercise all six CSR operations in one guest, checking sscratch after each
# operation. The guest must return from every operation and continue executing.
#
r0 = openat$kvm(0, &AUTO='/dev/kvm\x00', 0x0, 0x0)
r1 = ioctl$KVM_CREATE_VM(r0, AUTO, 0x0)
r2 = syz_kvm_setup_syzos_vm$riscv64(r1, &(0x7f0000c00000/0x400000)=nil)

# CSR 0x140 is sscratch; its KVM register ID is 0x8030000003000003.
# Operands are {csr, value, funct3, source_zero}. Register operations use a0
# unless source_zero selects x0; immediate operations use value & 0x1f.
#
r3 = syz_kvm_add_vcpu$riscv64(r2, &AUTO={0x0, &AUTO=[@csrop={AUTO, AUTO, {@valid=0x140, 0x1234567800000010, 0x1, 0x0}}, @uexit={AUTO, AUTO, 0x1}, @csrop={AUTO, AUTO, {@valid=0x140, 0x8000000000000003, 0x2, 0x0}}, @uexit={AUTO, AUTO, 0x2}, @csrop={AUTO, AUTO, {@valid=0x140, 0x1000000000000001, 0x3, 0x0}}, @uexit={AUTO, AUTO, 0x3}, @csrop={AUTO, AUTO, {@valid=0x140, 0x30, 0x5, 0x0}}, @uexit={AUTO, AUTO, 0x4}, @csrop={AUTO, AUTO, {@valid=0x140, 0x23, 0x6, 0x0}}, @uexit={AUTO, AUTO, 0x5}, @csrop={AUTO, AUTO, {@valid=0x140, 0x21, 0x7, 0x0}}, @uexit={AUTO, AUTO, 0x6}, @csrop={AUTO, AUTO, {@valid=0x140, 0xffffffffffffffff, 0x2, 0x1}}, @uexit={AUTO, AUTO, 0x7}, @csrop={AUTO, AUTO, {@valid=0x140, 0xffffffffffffffff, 0x3, 0x1}}, @uexit={AUTO, AUTO, 0x8}], AUTO}, 0x0, 0x0)
r4 = ioctl$KVM_GET_VCPU_MMAP_SIZE(r0, AUTO)
r5 = mmap$KVM_VCPU(&(0x7f0000009000/0x1000)=nil, r4, 0x3, 0x1, r3, 0x0)

# CSRRW writes the complete 64-bit register value, including bits above bit 31.
#
ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$riscv64(r3, r5, 0x1)
syz_kvm_assert_reg$riscv64(r3, 0x8030000003000003, 0x1234567800000010)

# CSRRS sets both high and low bits using a 64-bit mask.
#
ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$riscv64(r3, r5, 0x2)
syz_kvm_assert_reg$riscv64(r3, 0x8030000003000003, 0x9234567800000013)

# CSRRC clears both high and low bits using a 64-bit mask.
#
ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$riscv64(r3, r5, 0x3)
syz_kvm_assert_reg$riscv64(r3, 0x8030000003000003, 0x8234567800000012)

# CSRRWI writes only the low five bits of 0x30, replacing the previous value.
#
ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$riscv64(r3, r5, 0x4)
syz_kvm_assert_reg$riscv64(r3, 0x8030000003000003, 0x10)

# CSRRSI sets the bits selected by 0x23 & 0x1f.
#
ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$riscv64(r3, r5, 0x5)
syz_kvm_assert_reg$riscv64(r3, 0x8030000003000003, 0x13)

# CSRRCI clears the bits selected by 0x21 & 0x1f.
#
ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$riscv64(r3, r5, 0x6)
syz_kvm_assert_reg$riscv64(r3, 0x8030000003000003, 0x12)

# CSRRS with rs1=x0 reads without writing, ignoring the nonzero value operand.
#
ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$riscv64(r3, r5, 0x7)
syz_kvm_assert_reg$riscv64(r3, 0x8030000003000003, 0x12)

# CSRRC with rs1=x0 also leaves sscratch unchanged.
#
ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$riscv64(r3, r5, 0x8)
syz_kvm_assert_reg$riscv64(r3, 0x8030000003000003, 0x12)

# Run till the end of guest_main().
#
ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$riscv64(r3, r5, 0xffffffffffffffff)
