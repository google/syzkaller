# requires: arch=amd64 vendor=amd nested -threaded
#
r0 = openat$kvm(0, &AUTO='/dev/kvm\x00', 0x0, 0x0)
r1 = ioctl$KVM_CREATE_VM(r0, AUTO, 0x0)
r2 = syz_kvm_setup_syzos_vm$x86(r1, &(0x7f0000c00000/0x400000)=nil)

# Test the injection of an exception with an error code into L2.
#
# L1 injects #GP (vector=13, type=3 (exception), error_code=0, flags=3 (valid, error code valid))
# into an L2 VM that executes HLT.
#
r3 = syz_kvm_add_vcpu$x86(r2, &AUTO={0x0, &AUTO=[@enable_nested={AUTO, AUTO, 0x0}, @nested_create_vm={AUTO, AUTO, 0x0}, @nested_load_code={AUTO, AUTO, {0x0, "f4"}}, @nested_amd_inject_event={AUTO, AUTO, {0x0, 0xd, 0x3, 0x0, 0x3}}, @nested_vmlaunch={AUTO, AUTO, 0x0}], AUTO})
r4 = ioctl$KVM_GET_VCPU_MMAP_SIZE(r0, AUTO)
r5 = mmap$KVM_VCPU(&(0x7f0000009000/0x1000)=nil, r4, 0x3, 0x1, r3, 0x0)

# The exception is delivered to L2 before it executes HLT. L2 shares the IDT with L1, so the #GP
# handler of SYZOS reports UEXIT_EXCEPTION(13) (0xe2ec000d) from L2, and L1 forwards it with the
# nesting level in the top byte.
#
ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$x86(r3, r5, 0x1000000e2ec000d)
