# Test VMREAD executed by L2 with VMCS shadowing enabled.
#
# L1 turns a scratch page into a shadow VMCS (the vmcs12 revision 0x11e57ed0 with the bit 31 set),
# points the VMCS link pointer at it and enables VMCS shadowing (secondary processor-based control
# bit 14). The VMREAD bitmap is the zero page, so L1 does not intercept VMREAD for any field.
# L2 executes "mov eax, 0x6800; vmread rbx, rax; hlt".
#
r3 = syz_kvm_add_vcpu$x86(r2, &AUTO={0x0, &AUTO=[@memwrite={AUTO, AUTO, {0x58000, 0x0, 0x91e57ed0, 0x4}}, @enable_nested={AUTO, AUTO, 0x0}, @nested_create_vm={AUTO, AUTO, 0x0}, @nested_load_code={AUTO, AUTO, {0x0, "b8006800000f78c3f4"}}, @nested_intel_vmwrite_mask={AUTO, AUTO, {0x0, @control32=0x401e, 0x4000, 0x0, 0x0}}, @nested_intel_vmwrite_mask={AUTO, AUTO, {0x0, @guest64=0x2800, 0x58000, 0xffffffffffffffff, 0x0}}, @nested_vmlaunch={AUTO, AUTO, 0x0}], AUTO})
r4 = ioctl$KVM_GET_VCPU_MMAP_SIZE(r0, AUTO)
r5 = mmap$KVM_VCPU(&(0x7f0000009000/0x1000)=nil, r4, 0x3, 0x1, r3, 0x0)

# L0 emulates VMREAD on the shadow VMCS without exiting to L1 (that would be the exit reason 23,
# 0xe2110017), so the first exit L1 sees is HLT.
#
ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$x86(r3, r5, 0xe2e20001)
