#
# GCE nested VMX does not expose SECONDARY_EXEC_ENABLE_VMFUNC, so running this test requires
# hardware (or VMM) VMFUNC support, though it is still used as a fuzzing seed on all hosts.
#
# requires: arch=amd64 vendor=intel nested manual -threaded
#
r0 = openat$kvm(0, &AUTO='/dev/kvm\x00', 0x0, 0x0)
r1 = ioctl$KVM_CREATE_VM(r0, AUTO, 0x0)
r2 = syz_kvm_setup_syzos_vm$x86(r1, &(0x7f0000c00000/0x400000)=nil)

# Test VMFUNC VM-execution control checks in nested_check_vm_execution_controls():
# - VM 0: unsupported bit in VMCS_VM_FUNCTION_CONTROL (0x2018) -> VMLAUNCH error 7 (0xe2e10007).
# - VM 1: unaligned VMCS_EPTP_LIST_ADDRESS (0xdddd0001) -> VMLAUNCH error 7 (0xe2e10007).
# - VM 2: EPTP switching enabled without EPT (clearing bit 1 in 0x401e) -> VMLAUNCH error 7.
#
r3 = syz_kvm_add_vcpu$x86(r2, &AUTO={0x0, &AUTO=[@enable_nested={AUTO, AUTO, 0x0}, @nested_create_vm={AUTO, AUTO, 0x0}, @nested_intel_vmwrite_mask={AUTO, AUTO, {0x0, @control32=0x401e, 0x2000, 0x0, 0x0}}, @nested_intel_vmwrite_mask={AUTO, AUTO, {0x0, @control64=0x2018, 0x2, 0x0, 0x0}}, @nested_vmlaunch={AUTO, AUTO, 0x0}, @nested_create_vm={AUTO, AUTO, 0x1}, @nested_load_code={AUTO, AUTO, {0x1, "f4"}}, @nested_set_state_pages={AUTO, AUTO, {0x1, 0x3c, @unmapped=0xdddd0001}}, @nested_vmlaunch={AUTO, AUTO, 0x1}, @nested_create_vm={AUTO, AUTO, 0x2}, @nested_load_code={AUTO, AUTO, {0x2, "f4"}}, @nested_set_state_pages={AUTO, AUTO, {0x2, 0x3c, @gpa=0x58000}}, @nested_intel_vmwrite_mask={AUTO, AUTO, {0x2, @control32=0x401e, 0x0, 0x2, 0x0}}, @nested_vmlaunch={AUTO, AUTO, 0x2}, @uexit={AUTO, AUTO, 0xface}], AUTO})
r4 = ioctl$KVM_GET_VCPU_MMAP_SIZE(r0, AUTO)
r5 = mmap$KVM_VCPU(&(0x7f0000009000/0x1000)=nil, r4, 0x3, 0x1, r3, 0x0)

ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$x86(r3, r5, 0xe2e10007)
ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$x86(r3, r5, 0xe2e10007)
ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$x86(r3, r5, 0xe2e10007)
ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$x86(r3, r5, 0xface)
ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$x86(r3, r5, 0xffffffffffffffff)
