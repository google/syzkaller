#
# requires: arch=amd64 -threaded
#
r0 = openat$kvm(0, &AUTO='/dev/kvm\x00', 0x0, 0x0)
r1 = ioctl$KVM_CREATE_VM(r0, AUTO, 0x0)
r2 = syz_kvm_setup_syzos_vm$x86(r1, &(0x7f0000c00000/0x400000)=nil)

# Test that SYZOS rejects commands that are too short.
#
# vCPU 0: the size of the first command is 0, so SYZOS would never advance past it and execute it
# forever.
# vCPU 1: the size of the first command is 16, i.e. there is only room for the command header, and
# the exit code would be read from past the end of the command.
#
r3 = syz_kvm_add_vcpu$x86(r2, &AUTO={0x0, &AUTO=[@uexit={AUTO, 0x0, 0xface}, @uexit={AUTO, AUTO, 0xcafe}], AUTO})
r4 = ioctl$KVM_GET_VCPU_MMAP_SIZE(r0, AUTO)
r5 = mmap$KVM_VCPU(&(0x7f0000009000/0x1000)=nil, r4, 0x3, 0x1, r3, 0x0)
r6 = syz_kvm_add_vcpu$x86(r2, &AUTO={0x0, &AUTO=[@uexit={AUTO, 0x10, 0xface}, @uexit={AUTO, AUTO, 0xcafe}], AUTO})
r7 = mmap$KVM_VCPU(&(0x7f000000a000/0x1000)=nil, r4, 0x3, 0x1, r6, 0x0)

# SYZOS reports UEXIT_INVALID_MAIN (-4) instead of executing the command, and keeps reporting it.
#
ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$x86(r3, r5, 0xfffffffffffffffc)
ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$x86(r3, r5, 0xfffffffffffffffc)

ioctl$KVM_RUN(r6, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$x86(r6, r7, 0xfffffffffffffffc)
ioctl$KVM_RUN(r6, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$x86(r6, r7, 0xfffffffffffffffc)
