# Mounts a clean ext4 filesystem with fast_commit and orphan_file enabled,
# performs fast-commit-eligible metadata/data updates with fsync, and unlinks
# an open file so it is tracked in the orphan_file inode.
# Image: mkfs.ext4 -F -L syzkaller -U clear -N 256 -b 4096 -O fast_commit (8 MiB file).

r0 = syz_mount_image$ext4(&AUTO='ext4\x00', &AUTO='./mnt\x00', 0x0, &AUTO, 0x0, AUTO, &AUTO="$")
mknodat(r0, &AUTO='fc_a\x00', 0x8180, 0x0)
r1 = openat(r0, &AUTO='fc_a\x00', 0x2, 0x0)
pwrite64(r1, &AUTO='fast_commit_data', AUTO, 0x0)
fsync(r1)
linkat(r0, &AUTO='fc_a\x00', r0, &AUTO='fc_b\x00', 0x0)
fallocate(r1, 0x0, 0x1000, 0x2000)
fsync(r1)
unlinkat(r0, &AUTO='fc_a\x00', 0x0)
unlinkat(r0, &AUTO='fc_b\x00', 0x0)
fsync(r1)
