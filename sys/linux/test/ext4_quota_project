# Mounts a clean ext4 filesystem with quota and project features enabled,
# configures project quota limits, assigns a matching inherited project ID to a
# directory, creates a file inside it, and queries project statfs and quota.
# Image: mkfs.ext4 -F -L syzkaller -U clear -N 256 -b 4096 -O quota,project (8 MiB file).

r0 = syz_mount_image$ext4(&AUTO='ext4\x00', &AUTO='./mnt\x00', 0x0, &AUTO={[{@usrquota='usrquota', AUTO}, {@grpquota='grpquota', AUTO}, {@prjquota='prjquota', AUTO}], [], AUTO}, 0x0, AUTO, &AUTO="$")
quotactl_fd$Q_SETQUOTA(r0, 0x80000802, 0xee00, &AUTO={0x1000, 0x800, 0x0, 0x40, 0x20, 0x0, 0x0, 0x0, 0x5})
mkdirat(r0, &AUTO='projdir\x00', 0x1c0)
r1 = openat(r0, &AUTO='projdir\x00', 0x0, 0x0)
ioctl$FS_IOC_FSSETXATTR(r1, AUTO, &AUTO={0x200, 0x0, 0x0, 0xee00, 0x0, ""/8})
mknodat(r1, &AUTO='projfile\x00', 0x8180, 0x0)
r2 = openat(r1, &AUTO='projfile\x00', 0x2, 0x0)
pwrite64(r2, &AUTO='project_quota_payload', AUTO, 0x0)
fstatfs(r1, &AUTO=""/256)
quotactl_fd$Q_GETNEXTQUOTA(r0, 0x80000902, 0x0, &AUTO)
