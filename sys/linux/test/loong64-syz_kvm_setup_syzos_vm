#
# requires: arch=loong64
#

r0 = openat$kvm(0xffffffffffffff9c, &(0x7f0000000000), 0x0, 0x0)
r1 = ioctl$KVM_CREATE_VM(r0, AUTO, 0x0)
# 256 * 16KiB = 4MiB host memory for Loong64 SYZOS.
#
r2 = syz_kvm_setup_syzos_vm$loong64(r1, &(0x7f0000c00000/0x400000)=nil)

# Single UEXIT with exit code 0xaaaa.
#
r3 = syz_kvm_add_vcpu$loong64(r2, &AUTO={0x0, &AUTO=[@uexit={AUTO, AUTO, 0xaaaa}], AUTO}, 0x0, 0x0)

r4 = ioctl$KVM_GET_VCPU_MMAP_SIZE(r0, AUTO)
r5 = mmap$KVM_VCPU(&(0x7f0000010000/0x4000)=nil, r4, 0x3, 0x1, r3, 0x0)

ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$loong64(r3, r5, 0xaaaa)

# Run until guest_main() emits the final UEXIT_END marker.
#
ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_kvm_exit$loong64(r5, 0x6)
syz_kvm_assert_syzos_uexit$loong64(r3, r5, 0xffffffffffffffff)
