#
# requires: arch=arm64 -threaded
#
r0 = openat$kvm(0, &AUTO='/dev/kvm\x00', 0x0, 0x0)
r1 = ioctl$KVM_CREATE_VM(r0, AUTO, 0x0)
r2 = syz_kvm_setup_syzos_vm$arm64(r1, &(0x7f0000c00000/0x400000)=nil)

# Two vCPUs push a marker on their stack, trigger a uexit, pop the marker and report it with
# another exit:
#   mov x1, #marker; stp x1, xzr, [sp, #-16]!; mov x0, #0xdddd0100; mov x2, #first_exit;
#   str x2, [x0]; ldp x2, xzr, [sp], #16; str x2, [x0]
# vCPU 0 uses marker 0x1111 and first exit 0xa, vCPU 1 uses marker 0x2222 and first exit 0xc.
#
r3 = syz_kvm_add_vcpu$arm64(r2, &AUTO={0x0, &AUTO=[@code={AUTO, AUTO, {"212282d2e17fbfa9002080d2a0bbbbf2420180d2020000f9e27fc1a8020000f9", 0xd65f03c0}}], AUTO}, 0x0, 0x0)
r4 = ioctl$KVM_GET_VCPU_MMAP_SIZE(r0, AUTO)
r5 = mmap$KVM_VCPU(&(0x7f0000009000/0x1000)=nil, r4, 0x3, 0x1, r3, 0x0)
r6 = syz_kvm_add_vcpu$arm64(r2, &AUTO={0x0, &AUTO=[@code={AUTO, AUTO, {"414484d2e17fbfa9002080d2a0bbbbf2820180d2020000f9e27fc1a8020000f9", 0xd65f03c0}}], AUTO}, 0x0, 0x0)
r7 = mmap$KVM_VCPU(&(0x7f000000a000/0x1000)=nil, r4, 0x3, 0x1, r6, 0x0)

# Run each vCPU until its first exit so both stay suspended with their markers on the stack.
#
ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$arm64(r3, r5, 0xa)
ioctl$KVM_RUN(r6, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$arm64(r6, r7, 0xc)

# Each vCPU must pop its own marker without interference from the other vCPU.
#
ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$arm64(r3, r5, 0x1111)
ioctl$KVM_RUN(r6, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$arm64(r6, r7, 0x2222)

# Both vCPUs finish their programs.
#
ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$arm64(r3, r5, 0xffffffffffffffff)
ioctl$KVM_RUN(r6, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$arm64(r6, r7, 0xffffffffffffffff)
