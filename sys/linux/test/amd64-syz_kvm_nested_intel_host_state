# Create three Intel nested VMs, each with one invalid host-state field in its VMCS:
# - VM 0: HOST_SS_SELECTOR with RPL bits set.
# - VM 1: non-canonical HOST_FS_BASE.
# - VM 2: HOST_IA32_EFER without LMA, although the host is 64-bit. KVM only checks
#   the field if the "load IA32_EFER" VM-exit control (bit 21) is set, so set it too.
# Each VMLAUNCH fails nested_vmx_check_host_state() with VM-instruction error 8
# (VMXERR_ENTRY_INVALID_HOST_STATE_FIELD), which SYZOS reports as 0xe2e10008.
#
r3 = syz_kvm_add_vcpu$x86(r2, &AUTO={0x0, &AUTO=[@enable_nested={AUTO, AUTO, 0x0}, @nested_create_vm={AUTO, AUTO, 0x0}, @nested_load_code={AUTO, AUTO, {0x0, "f4"}}, @nested_intel_vmwrite_mask={AUTO, AUTO, {0x0, @host16=0xc04, 0x3, 0x0, 0x0}}, @nested_vmlaunch={AUTO, AUTO, 0x0}, @nested_create_vm={AUTO, AUTO, 0x1}, @nested_load_code={AUTO, AUTO, {0x1, "f4"}}, @nested_intel_vmwrite_mask={AUTO, AUTO, {0x1, @host_nat=0x6c06, 0x8000000000000000, 0x0, 0x0}}, @nested_vmlaunch={AUTO, AUTO, 0x1}, @nested_create_vm={AUTO, AUTO, 0x2}, @nested_load_code={AUTO, AUTO, {0x2, "f4"}}, @nested_intel_vmwrite_mask={AUTO, AUTO, {0x2, @control32=0x400c, 0x200000, 0x0, 0x0}}, @nested_intel_vmwrite_mask={AUTO, AUTO, {0x2, @host64=0x2c02, 0x0, 0x400, 0x0}}, @nested_vmlaunch={AUTO, AUTO, 0x2}], AUTO})
