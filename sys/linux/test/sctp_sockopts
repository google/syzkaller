setsockopt$inet_sctp_SCTP_PEER_ADDR_THLDS_V2(r0, 0x84, 0x25, &AUTO={0x0, @in={{AUTO, 0x4e20, @empty}}, 0x5, 0x1, 0x2}, AUTO)
getsockopt$inet_sctp_SCTP_PEER_ADDR_THLDS_V2(r0, 0x84, 0x25, &AUTO={0x0, @in={{AUTO, 0x4e20, @empty}}, 0x0, 0x0, 0x0}, &AUTO=AUTO)
setsockopt$inet_sctp_SCTP_REMOTE_UDP_ENCAPS_PORT(r0, 0x84, 0x84, &AUTO={0x0, @in={{AUTO, 0x4e20, @empty}}, 0x4e20}, AUTO)
