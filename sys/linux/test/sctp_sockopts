setsockopt$inet_sctp_SCTP_PLPMTUD_PROBE_INTERVAL(r0, 0x84, 0x85, &AUTO={0x0, @in={{AUTO, 0x4e20, @empty}}, 0x1388}, AUTO)
getsockopt$inet_sctp_SCTP_PLPMTUD_PROBE_INTERVAL(r0, 0x84, 0x85, &AUTO={0x0, @in={{AUTO, 0x4e20, @empty}}, 0x0}, &AUTO=AUTO)
