# Set and get SCTP socket options on a TCP-style socket, using the
# SCTP_FUTURE_ASSOC (0) association id and the wildcard address.

r0 = socket$inet_sctp(0x2, 0x1, 0x84)
setsockopt$inet_sctp_SCTP_REUSE_PORT(r0, 0x84, 0x24, &AUTO=0x1, AUTO)
getsockopt$inet_sctp_SCTP_REUSE_PORT(r0, 0x84, 0x24, &AUTO, &AUTO=AUTO)
setsockopt$inet_sctp_SCTP_AUTH_SUPPORTED(r0, 0x84, 0x81, &AUTO={0x0, 0x1}, AUTO)
getsockopt$inet_sctp_SCTP_AUTH_SUPPORTED(r0, 0x84, 0x81, &AUTO={0x0, 0x0}, &AUTO=AUTO)
