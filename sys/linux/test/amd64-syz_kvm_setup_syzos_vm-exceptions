#
ioctl$KVM_RUN(r10, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$x86(r10, r11, 0xbbbb)
ioctl$KVM_RUN(r10, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$x86(r10, r11, 0xffffffffffffffff)
