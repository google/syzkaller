{
  "compiler": "/usr/bin/gcc",
  "compiler_type": "gcc",
  "make": "make",
  "bin_dir": "/usr/bin",
  "kernel_repo": "https://github.com/torvalds/linux.git",
  "kernel_branch": "master",
  "syzkaller_repo": "https://github.com/google/syzkaller.git",
  "userspace": "/disk.raw",
  "kernel_config": "/config/dashboard/config/linux/upstream-apparmor-kasan.config",
  "manager": {
    "target": "linux/amd64",
    "workdir": "/tmp/syz-bisect-workdir",
    "kernel_src": "/git-cache",
    "syzkaller": "/go/src/github.com/google/syzkaller",
    "image": "/disk.raw",
    "sshkey": "/config/assets/id_rsa",
    "type": "qemu",
    "procs": 1,
    "cover": true,
    "vm": {
      "count": 1,
      "cmdline": "root=/dev/sda1 console=ttyS0",
      "qemu_args": "-enable-kvm"
    }
  }
}
