# Simulates a malicious kernel build that replaces a file with a symlink.
# If SYZ_TEST_SYMLINK is set to "stage path target" and the make target passed
# as the first argument matches stage, path is replaced with a symlink to target.

set -eu

[ -n "${SYZ_TEST_SYMLINK:-}" ] || exit 0
read -r stage path target <<< "$SYZ_TEST_SYMLINK"
[ "$1" = "$stage" ] || exit 0
mkdir -p "$(dirname "$path")"
rm -rf "$path"
ln -s "$target" "$path"
